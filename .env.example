# Application
APP_NAME="NovaCart Hybrid RAG Knowledge Assistant"
APP_DEBUG=false
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Ingestion and chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
PRODUCTS_CSV_PATH="data/raw/products.csv"

# Local embeddings
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=16
EMBEDDING_LOCAL_FILES_ONLY=false

# Persistent Chroma vector store
VECTOR_DB_PATH="data/vector_store"
VECTOR_COLLECTION_NAME="novacart_chunks"

# Retrieval and routing
RETRIEVAL_MODE="auto"
RETRIEVAL_TOP_K=5
BM25_INDEX_PATH="data/bm25_index.json"
BM25_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
HYBRID_DENSE_TOP_K=10
HYBRID_BM25_TOP_K=10
HYBRID_TOP_K=5

# Optional cross-encoder reranking
RERANK_ENABLED=true
RERANK_MODEL="BAAI/bge-reranker-base"
RERANK_CANDIDATES=20
RERANK_TOP_K=5
RERANK_BATCH_SIZE=8
RERANK_LOCAL_FILES_ONLY=false

# Context construction
RAG_CONTEXT_MAX_CHARACTERS=8000
RAG_CONTEXT_MAX_ITEMS=8

# Legacy Phase 6 CLI compatibility
RAG_RETRIEVAL_MODE="hybrid"

# Groq generation
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.1-8b-instant"
LLM_TIMEOUT_SECONDS=120
