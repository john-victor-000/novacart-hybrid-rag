# Optional: defaults work without a .env file.
APP_NAME="NovaCart Hybrid RAG Knowledge Assistant"
APP_DEBUG=false
CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=16
EMBEDDING_LOCAL_FILES_ONLY=false
VECTOR_DB_PATH="data/vector_store"
VECTOR_COLLECTION_NAME="novacart_chunks"
RETRIEVAL_TOP_K=5
BM25_INDEX_PATH="data/bm25_index.json"
BM25_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
HYBRID_DENSE_TOP_K=10
HYBRID_BM25_TOP_K=10
HYBRID_TOP_K=5
RAG_RETRIEVAL_MODE="dense"
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.1-8b-instant"
LLM_TIMEOUT_SECONDS=120
